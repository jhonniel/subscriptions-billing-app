VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — if Cloud Firestore has App Check enforcement ON, add a key from Console → App Check → your web app.
# With a key set, npm run dev auto-enables the debug token flow (check the browser console once, register the token).
# VITE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# VITE_APPCHECK_DEBUG_TOKEN=
# VITE_APPCHECK_DEV_PRINT_TOKEN=true
#
# If Firestore App Check enforcement is OFF, you can skip initializing App Check in the client:
# VITE_FIREBASE_APPCHECK_DISABLE=true
# (If enforcement is ON and you set this, Firestore will still reject reads — turn enforcement off or use keys above.)

# Optional (Analytics)
# VITE_FIREBASE_MEASUREMENT_ID=
