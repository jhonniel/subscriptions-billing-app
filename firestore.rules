rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function isAdmin() {
      return authed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return authed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    function managedBy(managerId, userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.createdBy == managerId;
    }

    /** Self-serve signup: only evaluate admin/manager branches when not the simple self-create case. */
    function canCreateUser(userId) {
      return authed() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'user' &&
          !request.resource.data.keys().hasAny(['createdBy'])
        )
          ? true
          : (
            isAdmin() ||
            (
              isManager() &&
              request.resource.data.role == 'user' &&
              request.resource.data.createdBy == request.auth.uid &&
              userId != request.auth.uid
            )
          )
      );
    }

    match /users/{userId} {
      // Own profile: allow both get and read so single-doc loads always match at least one branch.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if authed() && isAdmin();
      allow read: if authed() && isManager() && managedBy(request.auth.uid, userId);

      allow create: if canCreateUser(userId);

      // Self-update cannot change role (prevents privilege escalation); admins/managers use other branch.
      allow update: if authed() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
          ? true
          : (
            isAdmin() ||
            (isManager() && managedBy(request.auth.uid, userId))
          )
      );

      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if authed();
      allow create, update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if authed();
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{id} {
      allow read: if authed() && (
        (resource.data.userId == request.auth.uid)
          ? true
          : (
            isAdmin() ||
            (isManager() && managedBy(request.auth.uid, resource.data.userId))
          )
      );

      allow create: if authed() && (
        isAdmin() ||
        (isManager() && managedBy(request.auth.uid, request.resource.data.userId)) ||
        (!isAdmin() && !isManager() && request.resource.data.userId == request.auth.uid)
      );

      allow update, delete: if authed() && (
        isAdmin() ||
        (isManager() && managedBy(request.auth.uid, resource.data.userId))
      );
    }

    match /lending/{id} {
      allow read: if authed() && (
        (
          resource.data.lenderId == request.auth.uid ||
          resource.data.borrowerId == request.auth.uid
        )
          ? true
          : (
            isAdmin() ||
            (isManager() && (
              managedBy(request.auth.uid, resource.data.lenderId) ||
              managedBy(request.auth.uid, resource.data.borrowerId)
            ))
          )
      );

      allow create: if authed() && (
        isAdmin() ||
        (isManager() && (
          managedBy(request.auth.uid, request.resource.data.lenderId) ||
          managedBy(request.auth.uid, request.resource.data.borrowerId)
        )) ||
        request.resource.data.lenderId == request.auth.uid ||
        request.resource.data.borrowerId == request.auth.uid
      );

      allow update: if authed() && (
        isAdmin() ||
        (isManager() && (
          managedBy(request.auth.uid, resource.data.lenderId) ||
          managedBy(request.auth.uid, resource.data.borrowerId)
        )) ||
        resource.data.lenderId == request.auth.uid ||
        resource.data.borrowerId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if authed() && (
        (resource.data.userId == request.auth.uid)
          ? true
          : (
            isAdmin() ||
            (isManager() && managedBy(request.auth.uid, resource.data.userId)) ||
            (
              isManager() &&
              resource.data.keys().hasAny(['relatedUserId']) &&
              resource.data.relatedUserId != null &&
              managedBy(request.auth.uid, resource.data.relatedUserId)
            )
          )
      );

      allow create: if authed() && (
        isAdmin() ||
        (isManager() && (
          managedBy(request.auth.uid, request.resource.data.userId) ||
          (
            request.resource.data.keys().hasAny(['relatedUserId']) &&
            request.resource.data.relatedUserId != null &&
            managedBy(request.auth.uid, request.resource.data.relatedUserId)
          )
        )) ||
        request.resource.data.userId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }
  }
}
