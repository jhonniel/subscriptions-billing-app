rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    /**
     * Firestore role for the signed-in user, or '' if doc/field missing.
     * Uses hasAny(['role']) before reading .role so missing keys do not break evaluation.
     */
    function actorRole() {
      return (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['role'])
        )
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    /**
     * Custom claims: only read .admin / .manager if the key exists (avoids evaluation errors on absent keys).
     * Prefer claims so admin works even when Firestore profile get() is flaky; set via Admin SDK then re-login.
     */
    function isAdmin() {
      return authed() && (
        (
          request.auth.token.keys().hasAny(['admin']) &&
          request.auth.token.admin == true
        ) ||
        actorRole() == 'admin' ||
        actorRole() == 'Admin' ||
        actorRole() == 'ADMIN'
      );
    }

    function isManager() {
      return authed() && (
        (
          request.auth.token.keys().hasAny(['manager']) &&
          request.auth.token.manager == true
        ) ||
        actorRole() == 'manager' ||
        actorRole() == 'Manager' ||
        actorRole() == 'MANAGER'
      );
    }

    /** For rules on *other* collections: reads userId’s profile (not the doc being authorized). */
    function managedBy(managerId, userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.createdBy == managerId;
    }

    /** Inside match /users/{userId}: never get() the same path as the request — that recurses and denies. */
    function userDocManagedByActor() {
      return resource != null &&
        resource.data.keys().hasAny(['createdBy']) &&
        resource.data.createdBy == request.auth.uid;
    }

    /** Self-serve signup: only evaluate admin/manager branches when not the simple self-create case. */
    function canCreateUser(userId) {
      return authed() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'user' &&
          !request.resource.data.keys().hasAny(['createdBy'])
        )
          ? true
          : (
            isAdmin() ||
            (
              isManager() &&
              request.resource.data.role == 'user' &&
              request.resource.data.createdBy == request.auth.uid &&
              userId != request.auth.uid
            )
          )
      );
    }

    match /users/{userId} {
      // Any signed-in user may READ profiles (directory, lending pickers, admin user table).
      // Firestore list/get on `users` requires every possible result doc to pass read rules; mixed
      // legacy rows (missing name/email/role) otherwise make the whole query permission-denied.
      // Harden for public/multi-tenant apps by moving listing behind Cloud Functions + tighter rules.
      allow read: if authed();

      allow create: if canCreateUser(userId);

      // Self-update cannot change role (prevents privilege escalation); admins/managers use other branch.
      allow update: if authed() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
          ? true
          : (
            isAdmin() ||
            (isManager() && userDocManagedByActor())
          )
      );

      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if authed();
      allow create, update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if authed();
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{id} {
      allow read: if authed() && (
        (resource.data.userId == request.auth.uid)
          ? true
          : (
            isAdmin() ||
            (isManager() && managedBy(request.auth.uid, resource.data.userId))
          )
      );

      // Self-assign first so normal users never depend on isAdmin()/isManager() reads.
      allow create: if authed() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isManager() && managedBy(request.auth.uid, request.resource.data.userId))
      );

      allow update, delete: if authed() && (
        isAdmin() ||
        (isManager() && managedBy(request.auth.uid, resource.data.userId))
      );
    }

    match /lending/{id} {
      allow read: if authed() && (
        (
          resource.data.lenderId == request.auth.uid ||
          resource.data.borrowerId == request.auth.uid
        )
          ? true
          : (
            isAdmin() ||
            (isManager() && (
              managedBy(request.auth.uid, resource.data.lenderId) ||
              managedBy(request.auth.uid, resource.data.borrowerId)
            ))
          )
      );

      allow create: if authed() && (
        isAdmin() ||
        (isManager() && (
          managedBy(request.auth.uid, request.resource.data.lenderId) ||
          managedBy(request.auth.uid, request.resource.data.borrowerId)
        )) ||
        request.resource.data.lenderId == request.auth.uid ||
        request.resource.data.borrowerId == request.auth.uid
      );

      allow update: if authed() && (
        isAdmin() ||
        (isManager() && (
          managedBy(request.auth.uid, resource.data.lenderId) ||
          managedBy(request.auth.uid, resource.data.borrowerId)
        )) ||
        resource.data.lenderId == request.auth.uid ||
        resource.data.borrowerId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if authed() && (
        (resource.data.userId == request.auth.uid)
          ? true
          : (
            isAdmin() ||
            (isManager() && managedBy(request.auth.uid, resource.data.userId)) ||
            (
              isManager() &&
              resource.data.keys().hasAny(['relatedUserId']) &&
              resource.data.relatedUserId != null &&
              managedBy(request.auth.uid, resource.data.relatedUserId)
            )
          )
      );

      // Own activity first; admins/managers log subscription rows for other users after that.
      allow create: if authed() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isManager() && (
          managedBy(request.auth.uid, request.resource.data.userId) ||
          (
            request.resource.data.keys().hasAny(['relatedUserId']) &&
            request.resource.data.relatedUserId != null &&
            managedBy(request.auth.uid, request.resource.data.relatedUserId)
          )
        ))
      );

      allow update, delete: if isAdmin();
    }
  }
}
